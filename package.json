{
    "name": "message-hub-frontend-demo",
    "description": "A frontend-only corporate messenger portfolio demo built with Nuxt, Vue, TypeScript, and Pinia.",
    "private": true,
    "type": "module",
    "homepage": "https://message-hub-psi.vercel.app/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vitali-lavau/message-hub.git"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate": "nuxt generate",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:components && npm run test:e2e && npm run build",
        "screenshots": "node scripts/run-browser-suite.mjs playwright.screenshots.config.ts 3101",
        "test": "vitest run",
        "test:components": "vitest run tests/components",
        "test:e2e": "node scripts/run-browser-suite.mjs playwright.config.ts 3100",
        "test:e2e:ui": "node scripts/run-browser-suite.mjs playwright.config.ts 3100 --ui",
        "test:unit": "vitest run tests/unit",
        "test:watch": "vitest",
        "typecheck": "nuxt typecheck"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@pinia/nuxt": "^0.5.5",
        "@tiptap/extension-placeholder": "^2.9.1",
        "@tiptap/pm": "^2.9.1",
        "@tiptap/starter-kit": "^2.9.1",
        "@tiptap/vue-3": "^2.9.1",
        "date-fns": "^4.1.0",
        "emoji-picker-element": "^1.22.8",
        "normalize.css": "^8.0.1",
        "nuxt": "^3.13.2",
        "pinia": "^2.2.4",
        "vue": "latest",
        "vue-router": "latest",
        "vue-virtual-scroller": "^2.0.0-beta.8"
    },
    "devDependencies": {
        "@nuxt/eslint": "^0.5.7",
        "@nuxt/test-utils": "^3.13.1",
        "@pinia/testing": "^0.1.7",
        "@playwright/test": "^1.48.2",
        "@types/node": "^22.12.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.13.0",
        "eslint-config-prettier": "^9.1.0",
        "happy-dom": "^14.12.3",
        "postcss": "^8.4.47",
        "prettier": "^3.3.3",
        "sass": "^1.80.4",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.6.3",
        "vite": "^5.4.10",
        "vitest": "^1.6.0",
        "vue-tsc": "^2.1.10"
    }
}
